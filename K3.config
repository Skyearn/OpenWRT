# ===========================================================================
# Phicomm K3 (Broadcom BCM5301X, bcm53xx/generic, ARM Cortex-A9)
#
# This is a fragment: `make defconfig` fills in the rest from lede's defaults.
#
# The old file was generated against a much older lede and contained
# dependency-only entries (lib*, kmod-*, iptables-*, boost-*, libcurl options)
# plus symbols that no longer exist (luci-app-easymesh, luci-app-guest-wifi,
# luci-i18n-guest-wifi-zh-cn, luci-i18n-mwan3-zh-cn, luci-app-unblockmusic,
# luci-app-turboacc_INCLUDE_*).  They are all dropped here.
#
# Dependency packages are selected automatically by the apps below.
# ===========================================================================

# --- Target ---------------------------------------------------------------
CONFIG_TARGET_bcm53xx=y
CONFIG_TARGET_bcm53xx_generic=y
CONFIG_TARGET_bcm53xx_generic_DEVICE_phicomm_k3=y

# --- LuCI -----------------------------------------------------------------
# luci / uhttpd / luci-mod-admin-full / luci-app-turboacc / luci-app-vsftpd /
# luci-app-nlbwmon / luci-app-ssr-plus come from the default router package set.
CONFIG_PACKAGE_luci-theme-material=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# --- Multi-WAN ------------------------------------------------------------
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

# --- TurboACC (FastPath) --------------------------------------------------
# NOTE: the options are PACKAGE_TURBOACC_*, not luci-app-turboacc_*.
CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y

# --- IPv6 -----------------------------------------------------------------
# pulls odhcp6c, odhcpd-ipv6only, ip6tables, 6in4, kmod-ipt-nat6, ...
CONFIG_PACKAGE_ipv6helper=y

# --- ssr-plus (default router set, from the helloworld feed) --------------
# Select the components we use; the rest of its dependencies (microsocks,
# ip-full, resolveip, curl, luci-compat, ...) are pulled automatically.
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_V2ray_Plugin=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y

# --- Keep the 128 MB NAND image small -------------------------------------
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-app-nlbwmon is not set

# --- CLI ------------------------------------------------------------------
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_unzip=y
