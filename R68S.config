# ===========================================================================
# FastRhino R68S (Rockchip RK3568, aarch64)
#
# This is a fragment: `make defconfig` fills in the rest from lede's defaults.
# Keep only packages/options that still exist in the current feeds -- unknown
# symbols are silently dropped by `make defconfig`, which makes old configs
# very misleading.
#
# Dependency-only packages (lib*, kmod-*, iptables-*, coreutils*, boost*...) are
# selected automatically by the apps below and are intentionally not listed.
# ===========================================================================

# --- Target ---------------------------------------------------------------
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_fastrhino_r68s=y

# --- Image size (MB) ------------------------------------------------------
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# --- Wireless -------------------------------------------------------------
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wpad-wolfssl=y

# --- System ---------------------------------------------------------------
CONFIG_PACKAGE_autocore-arm=y
# pulls odhcp6c, odhcpd-ipv6only, ip6tables, 6in4, kmod-ipt-nat6, ...
CONFIG_PACKAGE_ipv6helper=y

# --- LuCI -----------------------------------------------------------------
CONFIG_PACKAGE_luci-theme-material=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y

# --- LuCI apps ------------------------------------------------------------
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-filetransfer=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-syncdial=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-vlmcsd=y

# --- passwall (option names as of luci-app-passwall 26.x) -----------------
# firewall4 is the default in lede, so only the nftables backend is usable.
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
# NaiveProxy pulls the host package `gn`, whose current revision does not
# compile with GCC 12 (libstdc++ 12 / C++20 ranges) on ubuntu-22.04.
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set

# --- TurboACC -------------------------------------------------------------
# NOTE: the options are PACKAGE_TURBOACC_*, not luci-app-turboacc_*.
CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y

# --- CLI ------------------------------------------------------------------
CONFIG_PACKAGE_nano=y
